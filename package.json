{
  "name": "ai-orchestrator",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "node scripts/run-test-chunks.mjs",
    "test:chunks": "node scripts/run-test-chunks.mjs",
    "test:chunks:product": "node scripts/run-test-chunks.mjs --exclude test/test-chunks-runner.test.ts",
    "test:chunks:product:ci": "node scripts/run-test-chunks.mjs --exclude test/test-chunks-runner.test.ts --concurrency 1 --chunk-timeout-ms 600000 --output-dir tmp/chunk-outputs",
    "demo:block:fake": "tsx scripts/demo-real-block-run-fake.ts",
    "demo:disposable-pilot": "node scripts/run-disposable-pilot-demo.mjs",
    "demo:acceptance-matrix:fake": "tsx src/cli.ts acceptance-matrix configs/acceptance-matrix.fake.json",
    "demo:operator-golden-path": "node scripts/run-operator-golden-path.mjs",
    "demo:rollback-policy-drill": "node scripts/run-rollback-policy-drill.mjs",
    "demo:block-follow-up-drill": "node scripts/run-block-follow-up-drill.mjs",
    "demo:post-push-follow-up-drill": "node scripts/run-post-push-follow-up-drill.mjs",
    "verify:product": "npm run typecheck && npm run build && npx tsx --test test/test-chunks-runner.test.ts && npm run test:chunks:product && npm run demo:block:fake && npm run demo:disposable-pilot",
    "verify:product:ci": "npm run typecheck && npm run build && npx tsx --test test/test-chunks-runner.test.ts && npm run test:chunks:product:ci && npm run demo:block:fake && npm run demo:disposable-pilot",
    "test:validation": "node scripts/run-validation-tests.mjs",
    "verify:summary": "node scripts/verify-testing-summary.mjs"
  },
  "dependencies": {
    "cross-spawn": "^7.0.6",
    "dotenv": "^16.4.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
